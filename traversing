#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
using namespace std;

int n;
vector<vector<char>> mat;
vector<vector<string>> dp;
vector<vector<int>> pathCount;

string dfs(int i, int j) {
    if (i == 0 && j == 0) return string(1, mat[0][0]);
    if (dp[i][j] != "") return dp[i][j];

    string up = (i > 0) ? dfs(i - 1, j) : "~";  // '~' is lexicographically largest
    string left = (j > 0) ? dfs(i, j - 1) : "~";

    if (up < left) {
        dp[i][j] = up + mat[i][j];
        pathCount[i][j] = pathCount[i - 1][j];
    } else if (left < up) {
        dp[i][j] = left + mat[i][j];
        pathCount[i][j] = pathCount[i][j - 1];
    } else {
        dp[i][j] = up + mat[i][j];
        pathCount[i][j] = pathCount[i - 1][j] + pathCount[i][j - 1];
    }
    return dp[i][j];
}

int main() {
    cin >> n;
    mat.resize(n, vector<char>(n));
    dp.resize(n, vector<string>(n, ""));
    pathCount.resize(n, vector<int>(n, 0));

    for (int i = 0; i < n; ++i)
        for (int j = 0; j < n; ++j)
            cin >> mat[i][j];

    pathCount[0][0] = 1;
    string result = dfs(n - 1, n - 1);
    cout << result << endl;
    cout << pathCount[n - 1][n - 1] << endl;

    return 0;
}
